{
  "name": "dsh-vision-bridge",
  "version": "0.3.3",
  "archived": true,
  "description": "DeepSeek Harness plugin: image-capable virtual provider (vision-router Pro/Flash) + OCR-first evidence routing, Apple Vision local OCR, structured evidence cache and fail-soft compatibility.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "adapters",
    "routing",
    "ocr",
    "providers",
    "evidence",
    "cache",
    "telemetry",
    "compat",
    "scripts",
    "bin",
    "ci",
    "docs",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build:ocr": "bash scripts/build-ocr.sh",
    "postinstall": "node scripts/install-ocr.mjs",
    "test": "node --test test/unit.test.mjs test/apply.test.mjs",
    "check": "node --check lib/index.js && node --check adapters/dsh.js && node --check lib/config.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
