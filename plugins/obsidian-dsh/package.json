{
  "name": "obsidian-dsh",
  "version": "0.1.0",
  "description": "Native Obsidian integration for DeepSeek Harness: sidebar chat, vault context, tool/approval UI, Direct & Orchestrated Pro/Flash modes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["obsidian", "deepseek", "harness", "dsh", "agent"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
