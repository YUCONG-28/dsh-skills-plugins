{
  "meta": {
    "plugin_version": "0.1.0",
    "created": "2026-08-17",
    "environment": "macOS, DSH Computer Use (helper-driven baseline, no LLM)",
    "notes": "Phase 0 Baseline：helper 传输层确定性执行基准（无 LLM 参与，llm_calls/input_tokens/output_tokens 为 0）。用于后续所有优化阶段的对比基准。任务只操作无害应用与 /tmp 临时文件，测试后全部清理。"
  },
  "tasks": [
    {
      "id": "open_terminal",
      "name": "打开 Terminal",
      "description": "打开 Terminal 应用并验证其窗口出现",
      "actions": [
        {
          "type": "open_app",
          "target": "Terminal"
        },
        {
          "type": "dismiss_dialogs",
          "app": "open_terminal"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "assert_app_window",
          "app": "Terminal"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "Terminal"
        }
      ]
    },
    {
      "id": "open_textedit",
      "name": "打开 TextEdit",
      "description": "打开 TextEdit 并验证窗口出现（含可能的 Open 对话框处理）",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "dismiss_dialogs",
          "app": "open_textedit"
        },
        {
          "type": "assert_app_window",
          "app": "TextEdit"
        },
        {
          "type": "new_document_if_dialog",
          "app": "TextEdit"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "open_finder",
      "name": "打开 Finder",
      "description": "打开 Finder 并验证窗口出现",
