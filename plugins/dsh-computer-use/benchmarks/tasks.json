        {
          "type": "open_app",
          "target": "Finder"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "assert_app_window",
          "app": "Finder"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "Finder"
        }
      ]
    },
