    {
      "id": "terminal_new_tab",
      "name": "Terminal 新标签页（Cmd+T）",
      "description": "Terminal Cmd+T 新建标签页，验证无异常",
      "actions": [
        {
          "type": "open_app",
          "target": "Terminal"
        },
        {
          "type": "dismiss_dialogs",
