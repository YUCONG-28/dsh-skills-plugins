        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "c",
          "modifiers": [
            "command"
          ],
          "activate": true
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "n",
