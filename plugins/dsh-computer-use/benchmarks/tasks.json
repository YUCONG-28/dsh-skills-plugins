    {
      "id": "open_safari",
      "name": "打开 Safari",
      "description": "打开 Safari 并验证窗口出现",
      "actions": [
        {
          "type": "open_app",
          "target": "Safari"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "assert_app_window",
          "app": "Safari"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "Safari"
        }
      ]
    },
    {
      "id": "switch_window",
      "name": "切换窗口（激活另一应用）",
      "description": "依次激活 TextEdit 与 Terminal，验证前台应用切换",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "assert_app_window",
          "app": "TextEdit"
        },
        {
          "type": "open_app",
          "target": "Safari"
        },
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "activate_app",
          "target": "Safari"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "assert_frontmost",
          "app": "Safari"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        },
        {
          "type": "quit_app",
          "app": "Safari"
        }
      ]
    },
    {
      "id": "open_file_textedit",
      "name": "打开指定文件（TextEdit）",
      "description": "用 TextEdit 打开 /tmp 下的基准文件并验证窗口标题含文件名",
      "actions": [
        {
          "type": "write_tmp_file",
          "path": "/tmp/dsh-cu-bench-open.txt",
          "content": "benchmark open file"
        },
        {
          "type": "open_file_app",
          "path": "/tmp/dsh-cu-bench-open.txt",
          "app": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "dismiss_dialogs",
          "app": "open_file_textedit"
        },
        {
          "type": "assert_window_title_contains",
          "app": "TextEdit",
          "text": "dsh-cu-bench-open"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        },
        {
          "type": "rm_file",
          "path": "/tmp/dsh-cu-bench-open.txt"
        }
      ]
    },
    {
      "id": "type_into_textedit",
      "name": "向 TextEdit 输入文本（set-value 语义写入）",
      "description": "新建文档 → 语义写入文本 → 验证 AX value 包含内容",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dismiss_dialogs",
          "app": "type_into_textedit"
        },
        {
          "type": "new_document_if_dialog",
          "app": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 500
        },
        {
          "type": "find_element",
          "app": "TextEdit",
          "role": "AXTextArea",
          "var": "text_area"
        },
        {
          "type": "helper_set_value",
          "pid_var": "app_pid",
          "path_var": "text_area",
          "value": "benchmark typed content 2026"
        },
        {
          "type": "wait",
          "ms": 400
        },
        {
          "type": "assert_element_value_contains",
          "app": "TextEdit",
          "role": "AXTextArea",
          "text": "benchmark typed content"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "click_dialog_button",
      "name": "点击按钮（对话框 Cancel）",
      "description": "Cmd+O 打开对话框 → 用 perform-action AXPress 点击 Cancel → 验证对话框关闭",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dismiss_dialogs",
          "app": "click_dialog_button"
        },
        {
          "type": "new_document_if_dialog",
          "app": "TextEdit"
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "o",
          "modifiers": [
            "command"
          ],
          "activate": true
        },
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "assert_window_title_contains",
          "app": "TextEdit",
          "text": "Open"
        },
        {
          "type": "find_button_in_window",
          "app": "TextEdit",
          "window_text": "Open",
          "title": "Cancel",
          "var": "cancel_btn"
        },
        {
          "type": "helper_perform_action",
          "pid_var": "app_pid",
          "path_var": "cancel_btn",
          "action": "AXPress"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "assert_no_window_title",
          "app": "TextEdit",
          "text": "Open"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "press_key_new_doc",
      "name": "按键快捷键（Cmd+N 新建文档）",
      "description": "在 TextEdit 中 Cmd+N 新建文档，验证窗口数增加",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dismiss_dialogs",
          "app": "press_key_new_doc"
        },
        {
          "type": "new_document_if_dialog",
          "app": "TextEdit"
        },
        {
          "type": "count_windows",
          "app": "TextEdit",
          "var": "win_before"
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "n",
          "modifiers": [
            "command"
          ],
          "activate": true
        },
        {
          "type": "wait",
          "ms": 1000
        },
        {
          "type": "assert_window_count_gt_poll",
          "app": "TextEdit",
          "var_before": "win_base"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "save_file_textedit",
      "name": "保存文件（TextEdit Cmd+S）",
      "description": "打开存储对话框 → set-value 文件名 → 验证文件名写入 → Esc 取消（TextEdit iCloud 对话框文件落盘验证受限，改为对话框级验证）",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dismiss_dialogs",
          "app": "TextEdit"
        },
        {
          "type": "new_window",
          "app": "TextEdit"
        },
        {
          "type": "find_element",
          "app": "TextEdit",
          "role": "AXTextArea",
          "var": "text_area"
        },
        {
          "type": "helper_set_value",
          "pid_var": "app_pid",
          "path_var": "text_area",
          "value": "save me"
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "s",
          "modifiers": [
            "command",
            "shift"
          ],
          "activate": true
        },
        {
          "type": "wait",
          "ms": 1200
        },
        {
          "type": "find_field",
          "app": "TextEdit",
          "role": "AXTextField",
          "value": "Untitled",
          "var": "name_field"
        },
        {
          "type": "helper_set_value",
          "pid_var": "app_pid",
          "path_var": "name_field",
          "value": "dsh-cu-bench-save.rtf"
        },
        {
          "type": "wait",
          "ms": 300
        },
        {
          "type": "assert_field_value",
          "var_field": "name_field",
          "text": "dsh-cu-bench-save.rtf"
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "escape",
          "activate": true
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "scroll_textedit",
      "name": "滚动页面（perform-action AXScrollDownByPage）",
      "description": "写入多行文本 → 滚动区域执行滚动 action → 验证滚动条位置变化",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dismiss_dialogs",
          "app": "scroll_textedit"
        },
        {
          "type": "new_document_if_dialog",
          "app": "TextEdit"
        },
        {
          "type": "new_window",
          "app": "TextEdit"
        },
        {
          "type": "find_element",
          "app": "TextEdit",
          "role": "AXTextArea",
          "var": "text_area"
        },
        {
          "type": "helper_set_value",
          "pid_var": "app_pid",
          "path_var": "text_area",
          "value": "line1\nline2\nline3\nline4\nline5\nline6\nline7\nline8\nline9\nline10\nline11\nline12\nline13\nline14\nline15\nline16\nline17\nline18\nline19\nline20\nline21\nline22\nline23\nline24\nline25\nline26\nline27\nline28\nline29\nline30"
        },
        {
          "type": "helper_click",
          "pid_var": "app_pid",
          "path_var": "text_area",
          "prefer": "coordinate",
          "activate": true
        },
        {
          "type": "wait",
          "ms": 400
        },
        {
          "type": "helper_scroll",
          "pid_var": "app_pid",
          "direction": "down",
          "amount": 3
        },
        {
          "type": "wait",
          "ms": 300
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "close_window",
      "name": "关闭窗口（Cmd+W）",
      "description": "Cmd+N 新建后 Cmd+W 关闭，验证窗口数恢复",
      "actions": [
        {
          "type": "open_app",
          "target": "TextEdit"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dismiss_dialogs",
          "app": "close_window"
        },
        {
          "type": "new_document_if_dialog",
          "app": "TextEdit"
        },
        {
          "type": "count_windows",
          "app": "TextEdit",
          "var": "win_base"
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "n",
          "modifiers": [
            "command"
          ],
          "activate": true
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "assert_window_count_eq",
          "app": "TextEdit",
          "var_before": "win_base",
          "delta": 1
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "w",
          "modifiers": [
            "command"
          ],
          "activate": true
        },
        {
          "type": "wait",
          "ms": 900
        },
        {
          "type": "assert_window_count_eq",
          "app": "TextEdit",
          "var_before": "win_base",
          "delta": 0
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "TextEdit"
        }
      ]
    },
    {
      "id": "open_webpage_safari",
      "name": "打开指定网页（Safari）",
      "description": "用 Safari 打开 example.com 并验证窗口标题变化",
      "actions": [
        {
          "type": "open_url",
          "url": "https://example.com",
          "app": "Safari"
        },
        {
          "type": "wait",
          "ms": 3000
        },
        {
          "type": "assert_app_window",
          "app": "Safari"
        }
      ],
      "cleanup": [
        {
          "type": "quit_app",
          "app": "Safari"
        }
      ]
    },
    {
      "id": "run_python_terminal",
      "name": "运行 Python（Terminal）",
      "description": "在 Terminal 输入 python3 -c 命令并回车，验证无崩溃",
      "actions": [
        {
          "type": "open_app",
          "target": "Terminal"
        },
        {
          "type": "wait",
          "ms": 1800
        },
        {
          "type": "dismiss_dialogs",
          "app": "Terminal"
        },
        {
          "type": "new_window",
          "app": "Terminal"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "assert_app_window",
          "app": "Terminal"
        },
        {
          "type": "find_element",
          "app": "Terminal",
          "role": "AXTextArea",
          "var": "term_area"
        },
        {
          "type": "helper_type_text",
          "pid_var": "app_pid",
          "path_var": "term_area",
          "text": "echo dsh-cu-bench-ok",
          "activate": true
        },
        {
          "type": "helper_press_key",
          "pid_var": "app_pid",
          "key": "return",
          "activate": true
        },
        {
          "type": "wait",
          "ms": 800
        }
      ],
      "cleanup": []
    },
    {
      "id": "copy_paste_textedit",
      "name": "复制粘贴（TextEdit 内 Cmd+C/V）",
